# Application
ONCOLENS_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# Database (SQLite default; use Postgres in Docker/production)
DATABASE_URL=sqlite+aiosqlite:///./data/oncolens.db
# DATABASE_URL=postgresql+asyncpg://oncolens:oncolens@postgres:5432/oncolens

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# Upload security
MAX_UPLOAD_BYTES=15728640
RATE_LIMIT=30/minute

# ML
ML_MODEL_NAME=efficientnet_b0
ML_DEVICE=cpu
ML_WEIGHTS_PATH=data/brain_tumor_weights.pt

# API (frontend)
ONCOLENS_API_URL=http://127.0.0.1:8000
